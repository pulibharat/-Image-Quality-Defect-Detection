# Copy to .env and adjust as needed. All values shown are the defaults.

# SQLAlchemy database URL. SQLite (file-based) by default; swap for
# postgresql+psycopg2://user:pass@host:5432/dbname to use Postgres.
DATABASE_URL=sqlite:///./data/app.db

# Directory containing the trained model artifacts (see ml/train_*.py).
MODEL_DIR=./models_store

# Directory where uploaded images and heatmap overlays are stored.
UPLOAD_DIR=./uploads

# Upload limits / validation.
MAX_UPLOAD_MB=15
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/bmp,image/tiff

# Comma-separated list of allowed CORS origins, or "*" for any origin
# (fine for local/demo use; restrict this in a real deployment).
CORS_ORIGINS=*
